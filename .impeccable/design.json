  "narrative": {
    "northStar": "A quiet page with a secret terminal",
    "overview": "A compact personal introduction typeset like a live text program on a light sheet. Self-hosted monospace, blue-black ink, steel text, and generous whitespace establish the approved quiet, coder-like character.\n\nThe visible prompt is a working browser terminal. Three independently changing identity words add restrained motion; the monochrome ASCII field remains a discovery behind a command. Interaction supplies the surprise without adding desktop-window decoration.",
    "keyCharacteristics": [
      "One self-hosted monospace family with modest size changes.",
      "Paper and ink, with steel supporting text and explicit keyboard focus.",
      "Compact text groups surrounded by generous whitespace.",
      "Independent identity motion with centered words and reduced-motion support.",
      "Text actions and a real prompt instead of interface chrome."
    ],
    "rules": [
      {
        "name": "The Semantic Ink Rule",
        "body": "Use ink for the name, prompt, and actionable output; use secondary for supporting content and subtle for utilities. Focus and selection colors serve interaction only.",
        "section": "colors"
      },
      {
        "name": "The One Face Rule",
        "body": "Use Fira Code throughout, with regular weight and size, spacing, and tone establishing hierarchy. Disable ligatures so command text stays literal.",
        "section": "typography"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "Keep the homepage flat. Whitespace, text color, and ordering supply hierarchy; the input focus underline supplies state rather than elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic palette roles together when switching themes.",
      "Do keep text actions keyboard accessible with visible focus.",
      "Do keep founder, engineer, designer as the initial and stable accessible identity.",
      "Do preserve independent word timing, centered alignment, and reduced-motion behavior.",
      "Do keep terminal output readable as semantic text and genuine links."
    ],
    "donts": [
      "Don't add cards, window chrome, or decorative shadows to this homepage.",
      "Don't enlarge the name into an oversized marketing headline.",
      "Don't replace the approved identity with the superseded software-engineer subtitle.",
      "Don't expose the ASCII field as decoration in the first viewport.",
      "Don't disguise arbitrary code execution as a terminal command."
    ]
  }
